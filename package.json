{
  "name": "princesses",
  "version": "1.0.0",
  "description": "16Princesses Test - Interactive Princess Personality Website",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:analyze": "npm run build && npx vite-bundle-analyzer dist/stats.html",
    "deploy:netlify": "npm run build && npx netlify deploy --dir=dist --prod",
    "deploy:gh-pages": "npm run build && npx gh-pages -d dist",
    "serve": "npx serve dist"
  },
  "keywords": ["react", "typescript", "vite", "personality-test"],
